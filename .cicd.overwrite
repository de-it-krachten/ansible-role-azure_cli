---

# Generic
generic:
  role: ansible-role-azure_cli
  role_short: azure_cli
  role_description: |
    Installs the azure cli on a variety of platforms
  collections: []

# Supported platforms
platforms:
  debian13:
    supported: false
    ci: false
  fedora42:
    supported: true
    ci: false
  fedora43:
    supported: true
    ci: false

# Platforms
# Molecule
molecule:
  requirements:
    roles_extra: []
  prepare:
    vars:
      activate_epel: true
      install_python: true
      install_python38: true
  converge:
    vars:
      azure_cli_extensions:
        - name: aks-preview
        - name: ssh
          system: true
        - name: image-copy-extension
          version: 0.2.12

  
